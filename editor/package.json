{
  "name": "stlt-chaser",
  "productName": "STLT-CHASER",
  "version": "1.2.0",
  "description": "Sequence editor for the STLT-CHASER Resolume plugins",
  "main": "main.js",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "STILLET",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.mjs\"",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "org.stltchaser.editor",
    "productName": "STLT-CHASER",
    "copyright": "Copyright © 2026 STILLET. GPL-3.0.",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "plugins.js",
      "index.html",
      "styles.css",
      "src/**/*",
      "dev/mock-host.js",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../plugin/dist",
        "to": "plugins"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "STLT-CHASER-${version}-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "../LICENSE",
      "createDesktopShortcut": true,
      "shortcutName": "STLT-CHASER"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.video",
      "x64ArchFiles": "Contents/Resources/plugins/**/*",
      "identity": null,
      "artifactName": "STLT-CHASER-${version}-macOS.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alfonsostillet/stlt-chaser.git"
  },
  "homepage": "https://github.com/alfonsostillet/stlt-chaser"
}
